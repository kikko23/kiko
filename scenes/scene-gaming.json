{
    "scene_name": "Gaming",
    "description": "Scène pour streaming de jeu avec webcam et overlay",
    "sources": [
        {
            "name": "Capture de jeu",
            "type": "game_capture",
            "settings": {
                "capture_mode": "window",
                "priority": 0,
                "capture_cursor": true
            },
            "position": {
                "x": 0,
                "y": 0,
                "width": 1920,
                "height": 1080
            },
            "order": 1
        },
        {
            "name": "Webcam",
            "type": "dshow_input",
            "settings": {
                "video_device_id": "default",
                "resolution": "1920x1080",
                "fps": 30
            },
            "position": {
                "x": 1520,
                "y": 780,
                "width": 384,
                "height": 216
            },
            "order": 2,
            "filters": [
                {
                    "name": "Chroma Key",
                    "type": "chroma_key_filter",
                    "enabled": false
                },
                {
                    "name": "Cadre",
                    "type": "color_filter",
                    "enabled": true
                }
            ]
        },
        {
            "name": "Overlay",
            "type": "image_source",
            "settings": {
                "file": "./assets/overlay-gaming.png"
            },
            "position": {
                "x": 0,
                "y": 0,
                "width": 1920,
                "height": 1080
            },
            "order": 3
        },
        {
            "name": "Nom du stream",
            "type": "text_gdiplus",
            "settings": {
                "text": "Mon Stream",
                "font": {
                    "face": "Arial",
                    "size": 48,
                    "bold": true
                },
                "color": "#FFFFFF",
                "outline": true,
                "outline_color": "#000000"
            },
            "position": {
                "x": 960,
                "y": 50
            },
            "order": 4
        }
    ],
    "audio": {
        "desktop_audio": true,
        "mic_audio": true
    }
}
